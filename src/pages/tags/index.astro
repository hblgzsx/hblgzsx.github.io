---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import { tagUrl } from '../../lib/tags.mjs';
import { topics } from '../../config';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap(p => p.data.tags))].map(name => ({ name, count: posts.filter(p => p.data.tags.includes(name)).length })).sort((a,b) => b.count-a.count || a.name.localeCompare(b.name, 'zh-CN'));
---
<Base title="标签索引"><div class="page-wrap content-narrow"><header class="page-heading"><div class="eyebrow">FIND A THREAD</div><h1>标签索引</h1><p>先按大类浏览，再沿着具体的技术、方法与工具深入阅读。</p></header><div class="filter-bar">{topics.map(t => <a class="filter-button" href={`/topics/${t.id}/`}>{t.name}<span>{posts.filter(p=>p.data.topic===t.id).length}</span></a>)}</div><div class="tag-cloud">{tags.map(tag => <a href={tagUrl(tag.name)}>{tag.name}<span>{tag.count}</span></a>)}</div></div></Base>
<style>.tag-cloud{display:flex;flex-wrap:wrap;gap:12px;padding:12px 0}.tag-cloud a{display:flex;align-items:center;gap:14px;background:var(--paper);border:1px solid var(--line);padding:10px 15px;border-radius:3px;font-size:13px}.tag-cloud a:hover{border-color:var(--green);color:var(--green)}.tag-cloud span{font-size:10px;color:var(--muted);background:var(--green-soft);padding:0 6px;border-radius:2px}</style>

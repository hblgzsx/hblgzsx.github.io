---
import { getPosts, postUrl } from '../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  const articlePaths = posts.filter(p => p.data.legacy).map(p => ({ params: { legacy: p.data.legacy?.replace(/^\/+|\/+$/g, '') }, props: { target: postUrl(p) } }));
  return [...articlePaths, ...['categories', 'categories/ACM', 'categories/Python', 'archives/2023', 'archives/2023/12', 'archives/2024', 'archives/2024/01', 'archives/2024/02', 'tags/ACM', 'tags/div3', 'tags/div4'].map(path => ({ params: { legacy: path }, props: { target: path.startsWith('archives') ? '/archives/' : path.startsWith('tags') ? '/tags/' : '/topics/' } }))];
}
const { target } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0;url=${target}`} /><link rel="canonical" href={new URL(target, Astro.site).href} /><title>文章已迁移 · hblgzsx</title></head><body><p>文章已迁移到新的地址。<a href={target}>继续阅读 →</a></p></body></html>

$sage-bg = #edf1e9
$sage-paper = #f9faf6
$sage-green = #345e47
$sage-line = #d6dfcf

body
  background $sage-bg
  color #2c3c31

.headband
  background $sage-green
  height 3px

.header-inner, .main-inner, .footer-inner
  max-width 1200px

.site-brand-container
  background #304e3b

.site-title
  font-family Georgia, 'Noto Serif SC', 'SimSun', serif
  font-size 25px
  letter-spacing 1px

.site-subtitle
  margin-top 12px
  font-size 12px
  color #d2ddc9

.site-description
  color #74816e
  line-height 1.9

.header-inner, .sidebar-inner, .content-wrap
  box-shadow none
  border 1px solid $sage-line
  border-radius 3px

.header-inner, .sidebar-inner, .post-block, .content-wrap
  background $sage-paper

.sidebar-inner
  padding-top 24px

.post-title
  font-size 26px
  font-family 'Noto Serif SC', 'Source Han Serif SC', 'SimSun', serif
  line-height 1.7
  font-weight 600

.post-title-link
  color #304b39

.post-meta
  font-size 11px
  line-height 2
  margin-top 14px

.post-body
  font-size 16px
  line-height 2
  color #304035

.post-body h2, .post-body h3
  font-family 'Noto Serif SC', 'Source Han Serif SC', 'SimSun', serif
  line-height 1.8
  margin-top 1.8em

.post-body h2
  font-size 23px

.post-body h3
  font-size 19px

.post-body a
  color $sage-green

.post-body blockquote
  border-left-color #8ca27c
  background #e7edde
  padding 12px 20px
  color #657360

.post-body img
  border 0
  max-width 100%

.post-body code
  background #e7ecdf

.post-button .btn
  border-color #849c77
  color $sage-green
  border-radius 2px
  font-size 12px

.post-button .btn:hover
  background $sage-green
  color $sage-paper

.post-eof
  background $sage-line
  width 100%
  margin 50px auto

.menu-item-active a, .menu-item a:hover
  background #e6edde

.sidebar-nav-toc .sidebar-nav-active, .sidebar-toc-active .sidebar-nav-toc
  color $sage-green
  border-bottom-color $sage-green

.sidebar-toc-active .sidebar-toc .nav-link:hover, .sidebar-toc-active .sidebar-toc .nav-link.active
  color $sage-green
  border-bottom-color $sage-green

.footer
  color #73816c
  font-size 11px

.theme-switch-banner
  font-size 11px
  line-height 1.8
  border-bottom 1px solid $sage-line
  padding 11px 20px
  background #e4ebdc
  text-align right
  color #5b7051

.theme-switch-banner a
  color $sage-green
  border-bottom 1px solid #a5b898
  margin-left 10px

.main-inner
  padding-top 25px

.posts-expand .post-header
  margin-bottom 30px

@media (max-width: 767px)
  .post-title
    font-size 23px
  .post-body
    font-size 15px
  .theme-switch-banner
    padding 9px 15px
    text-align center
  .content-wrap
    border-left 0
    border-right 0
